# Google AI Studio API Key for Gemma 4
GEMMA_API_KEY=your_google_ai_studio_api_key_here

# Open-weight Gemma 4 models
GEMMA_PRIMARY_MODEL=gemma-4-26b-a4b-it
GEMMA_CRITIC_MODEL=gemma-4-26b-a4b-it

# OpenRouter Failover configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
